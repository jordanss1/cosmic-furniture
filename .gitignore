# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
videos/    

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything except examples/docs
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
my.cnf/
# certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_dsa
id_ecdsa
id_ed25519

# credential stores (often contain auth tokens)
.npmrc
.pypirc
.netrc
.htpasswd

# cloud / service account credentials
service-account*.json
serviceAccount*.json
*-service-account*.json
firebase-adminsdk*.json
.aws/
.gcloud/
.kube/

# secret folders and files
/.secrets/
/.secret/
/.private/
*.secret
*.secrets

# auth state, tokens and cookies (e.g. Playwright storage state)
cookies.txt
storageState*.json
*.token
*.session

# local databases and dumps
*.sqlite
*.sqlite3
*.db
*.dump
dump.sql
